rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidSupply(data) {
      return data.genericName is string
        && data.genericName.size() > 0
        && data.genericName.size() <= 200
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 50
        && data.sellingPrice is number
        && data.sellingPrice >= 0
        && data.buyingPrice is number
        && data.buyingPrice >= 0
        && (('quantity' in data && data.quantity is number) || ('stock' in data && data.stock is number));
    }

    // Centralized supplies catalog
    match /supplies/{supplyId} {
      allow read: if true;
      allow create, update: if isValidId(supplyId) && isValidSupply(request.resource.data);
      allow delete: if isValidId(supplyId);
    }

    // Canvass quotations
    match /canvassSlips/{slipId} {
      allow read: if true;
      allow create: if isValidId(slipId)
        && request.resource.data.canvassNumber is string
        && request.resource.data.customerName is string
        && request.resource.data.totalAmount is number;
      allow update, delete: if isValidId(slipId);
    }
  }
}
