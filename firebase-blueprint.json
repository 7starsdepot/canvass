{
  "entities": {
    "SupplyItem": {
      "title": "Supply Item",
      "description": "Office or school supply item with SKU, generic name, brand, description, unit, buying price, selling price, and stock quantity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "genericName": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["genericName", "unit", "buyingPrice", "sellingPrice", "quantity"]
    },
    "CanvassSlip": {
      "title": "Canvass Slip",
      "description": "Price canvass quotation generated by customers or depot personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "canvassNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "departmentOrCompany": { "type": "string" },
        "companyName": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["canvassNumber", "customerName", "items", "totalAmount", "createdAt"]
    }
  },
  "firestore": {
    "/supplies/{supplyId}": {
      "schema": "SupplyItem",
      "description": "Centralized inventory catalog containing all supplies and price points shared across all users and devices"
    },
    "/canvassSlips/{slipId}": {
      "schema": "CanvassSlip",
      "description": "Centralized canvass quotations generated across devices"
    }
  }
}
